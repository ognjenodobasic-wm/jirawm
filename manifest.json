{
  "manifest_version": 3,
  "name": "JiraWM",
  "version": "2.1.0",
  "description": "Jira task creator — screenshot to subtask",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "notifications",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/worker.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open JiraWM"
    }
  }
}
